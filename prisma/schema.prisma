// Leaf Log — data model. Postgres on Railway via Prisma.
// Privacy is enforced at the application/query layer (no RLS); see lib/flights/repo.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth.js (NextAuth) adapter models ----------
model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  accounts      Account[]
  sessions      Session[]
  profile       Profile?
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------- Application models ----------
model Profile {
  id                 String        @id // == User.id (1:1)
  user               User          @relation(fields: [id], references: [id], onDelete: Cascade)
  handle             String        @unique
  displayName        String
  bio                String?
  // Default visibility applied to newly ingested flights (private | friends | public).
  defaultVisibility  String        @default("private")
  // Set whenever the avatar is (re)uploaded; null = no avatar. Doubles as a
  // cache-busting key for the public avatar serve route.
  avatarUpdatedAt    DateTime?
  avatar             Avatar?
  // Dormant since SPRINT-004: self-asserted persistent location on a public
  // handle needs its own privacy design, not a free ride on the user-sites work.
  homeSiteId         String?
  homeSite           Site?         @relation("HomeSite", fields: [homeSiteId], references: [id], onDelete: SetNull)
  ownedSites         Site[]        @relation("OwnedSites")
  ownedZones         Zone[]        @relation("OwnedZones")
  // SPRINT-006: attribution for the last pilot to set/clear a boundary —
  // may differ from the row's own owner (a site owner may edit a zone's
  // boundary under lib/sites/associate.ts's findZoneEditableBy rule).
  boundaryUpdatedSites Site[]      @relation("BoundaryUpdatedSites")
  boundaryUpdatedZones Zone[]      @relation("BoundaryUpdatedZones")
  // SPRINT-007: community ownership for PUBLIC sites/zones — an append-only
  // audit trail plus one-vote-per-pilot endorsements. See Site/Zone below.
  locationAuditEntries LocationAuditEntry[] @relation("LocationAuditEntries")
  siteEndorsements     SiteEndorsement[]    @relation("SiteEndorsements")
  zoneEndorsements     ZoneEndorsement[]    @relation("ZoneEndorsements")
  flights            Flight[]
  // SPRINT-009 PR3 — flights this pilot is currently the assigned
  // instructor of record for. See Flight.instructorId.
  instructorFlights  Flight[]      @relation("FlightInstructor")
  sentFriendReqs     Friendship[]  @relation("SentFriendRequests")
  receivedFriendReqs Friendship[]  @relation("ReceivedFriendRequests")
  kudos              Kudo[]
  deviceTokens       DeviceToken[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model DeviceToken {
  id           String    @id @default(cuid())
  ownerId      String
  owner        Profile   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  label        String
  deviceId     String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  lastFlightId String?
  lastFlight   Flight?   @relation("DeviceTokenLastFlight", fields: [lastFlightId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([lastFlightId])
}

model DevicePairing {
  id               String   @id @default(cuid())
  codeHash         String   @unique
  pollHandleHash   String   @unique
  status           String
  label            String?
  claimedByOwnerId String?
  deviceTokenId    String?
  // Plaintext device token is held only after claim and before the device's
  // successful poll. pollPairing clears it when status moves to consumed.
  tokenPlaintext   String?
  createdAt        DateTime @default(now())
  expiresAt        DateTime

  @@index([expiresAt])
}

// Explicit friend graph: one directed request row, accepted means friends both ways.
// Decline/cancel removes the row. The no-self CHECK lives in the raw SQL migration
// because Prisma v6 cannot represent CHECK constraints in schema.prisma; migrate
// diff drift for that constraint is expected.
model Friendship {
  requesterId String
  addresseeId String
  status      String // "pending" | "accepted"
  requester   Profile   @relation("SentFriendRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   Profile   @relation("ReceivedFriendRequests", fields: [addresseeId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@id([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

model Kudo {
  flightId  String
  profileId String
  flight    Flight   @relation(fields: [flightId], references: [id], onDelete: Cascade)
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([flightId, profileId])
  @@index([flightId, createdAt])
}

// Sanitized, downscaled, center-cropped square avatar bytes (no originals, no
// EXIF). Kept off the Profile row so profile/flight list queries stay light;
// mirrors the Photo/PhotoData split. Served via the public avatar route.
model Avatar {
  profileId String  @id
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  image     Bytes // JPEG, 512x512
  thumb     Bytes // JPEG, 128x128
}

model Flight {
  id                    String        @id @default(cuid())
  ownerId               String
  owner                 Profile       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  visibility            String        @default("private") // private | friends | public
  source                String        @default("web_upload") // web_upload | device_push
  status                String        @default("uploaded") // uploaded | processing | ready | failed
  igcSha256             String
  parserVersion         String        @default("1")
  parseWarnings         Json          @default("[]")
  failureReason         String?
  // owner's free-text notes about the flight — shown wherever the flight
  // itself is visible, edited only from the flight-edit page
  notes                 String?
  // solo | tandem; null = solo-equivalent (matches every pre-existing row,
  // since ingestion never distinguished tandem flights before this). Drives
  // exact solo-airtime for USHPA ratings (lib/ratings/stats.ts).
  occupancy             String?
  // Self-reported flight-character tags (currently just "XC" — cross
  // country). Separate from launchTypes: this describes the flight as a
  // whole, not how it launched. See lib/ratings/skill-tags.ts.
  flightTypeTags        String[]      @default([])
  // Self-reported USHPA Special-Skill launch tags — CL/RS/FSL/TUR/HA/AWCL/ST.
  // Multiple may apply to one flight. Feeds the "self-reported, pending an
  // instructor's sign-off" tallies on /ratings — never counts as verified
  // completion on its own. See lib/ratings/skill-tags.ts.
  launchTypes           String[]      @default([])
  // Did this flight land in a Restricted Landing Field (a USHPA Special
  // Skill)? Same self-reported/pending-instructor treatment as launchTypes.
  restrictedLandingField Boolean      @default(false)
  // header facts
  flightDate            DateTime?     @db.Date
  takeoffAt             DateTime?
  landingAt             DateTime?
  localTz               String?
  localUtcOffsetMinutes Int?
  glider                String?
  recorder              String?
  // derived metrics
  durationS             Int?
  maxAltM               Int?
  altGainM              Int?
  maxClimbMs            Float?
  maxSinkMs             Float?
  altSource             String?
  trackDistM            Int?
  straightDistM         Int?
  takeoffLat            Float?
  takeoffLon            Float?
  landingLat            Float?
  landingLon            Float?
  bounds                Json?
  // located sites (denormalized name kept for history)
  takeoffSiteId         String?
  takeoffSite           Site?         @relation("TakeoffSite", fields: [takeoffSiteId], references: [id], onDelete: SetNull)
  takeoffSiteName       String?
  landingSiteId         String?
  landingSite           Site?         @relation("LandingSite", fields: [landingSiteId], references: [id], onDelete: SetNull)
  landingSiteName       String?
  // located zones (SPRINT-005) — a zone is a specific launch/landing spot
  // WITHIN the site above; zoneId is only ever non-null alongside its own
  // siteId (zone.siteId === flight.takeoffSiteId), enforced by the single
  // cache writer in lib/sites/associate.ts, not a DB constraint — see
  // docs/sprints/SPRINT-005.md "No Flight-side zoneId ⇒ siteId CHECK".
  // Cached name is nulled (not kept as history) when the zone itself is
  // deleted — the historical-fallback cache is reserved for a deleted SITE.
  takeoffZoneId         String?
  takeoffZone           Zone?         @relation("TakeoffZone", fields: [takeoffZoneId], references: [id], onDelete: SetNull)
  takeoffZoneName       String?
  landingZoneId         String?
  landingZone           Zone?         @relation("LandingZone", fields: [landingZoneId], references: [id], onDelete: SetNull)
  landingZoneName       String?
  data                  FlightData?
  photos                Photo[]
  kudos                 Kudo[]
  latestForDeviceTokens DeviceToken[] @relation("DeviceTokenLastFlight")
  // SPRINT-009 PR3 — mutable; gates FUTURE InstructorNote/RatingSignoff
  // writes only (once those land). Assignable only by ownerId, only to a
  // profile currently in listFriends(ownerId), re-checked server-side at
  // write time — see lib/ratings/authz.ts::canAssignInstructor. Reassigning
  // or clearing this does NOT delete or hide any note/signoff written while
  // a prior instructorId was current (those are keyed to their own
  // immutable author column, not this field).
  instructorId          String?
  instructor            Profile?      @relation("FlightInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@unique([ownerId, igcSha256])
  @@index([ownerId, flightDate])
  @@index([ownerId, status, flightDate])
  @@index([takeoffSiteId])
  @@index([landingSiteId])
  @@index([takeoffZoneId])
  @@index([landingZoneId])
  @@index([instructorId])
}

// Heavy payloads kept off the Flight row so logbook/profile lists stay fast.
model FlightData {
  flightId String @id
  flight   Flight @relation(fields: [flightId], references: [id], onDelete: Cascade)
  rawIgc   Bytes // original .igc bytes (source of truth)
  track    Json? // derived render artifact (line + barograph)
}

// A photo attached to a flight. Light metadata row (no image bytes) so the
// gallery list stays fast; bytes live in PhotoData (mirrors Flight/FlightData).
model Photo {
  id       String @id @default(cuid())
  flightId String
  flight   Flight @relation(fields: [flightId], references: [id], onDelete: Cascade)

  originalFilename String?
  contentType      String  @default("image/jpeg") // output type (jpeg in v1)
  displayWidth     Int
  displayHeight    Int
  displayBytes     Int
  thumbWidth       Int
  thumbHeight      Int
  thumbBytes       Int

  takenAt                DateTime? // UTC instant of capture
  tSec                   Float? // seconds from takeoff (timeline link) when time-placed
  exifOffsetMinutes      Int? // diagnostic only; the flight offset is used for placement
  lat                    Float?
  lon                    Float?
  altM                   Int?
  placementSource        String    @default("unpinned") // exif_gps | interpolated_time | unpinned
  placementFailureReason String? // no_time | out_of_window | missing_flight_offset | bad_gps

  sha256    String // over the ORIGINAL bytes — exact-dupe guard
  data      PhotoData?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([flightId, sha256])
  @@index([flightId, takenAt])
}

// Sanitized, downscaled image bytes (no originals, no EXIF). Fetched on demand
// via the per-photo serve route, kept off the Photo row.
model PhotoData {
  photoId String @id
  photo   Photo  @relation(fields: [photoId], references: [id], onDelete: Cascade)
  display Bytes // JPEG, <=2048px long edge
  thumb   Bytes // JPEG, <=420px long edge
}

model Site {
  id             String    @id @default(cuid())
  name           String
  normalizedName String // NFKC + folded, for proximity-scoped dup checks
  kind           String    @default("unknown") // takeoff | landing | both | unknown
  lat            Float
  lon            Float
  countryCode    String?
  region         String?
  source         String    @default("manual") // manual | user
  sourceId       String?
  sourceUrl      String?
  license        String?
  ownerId        String? // null for curated seeds
  owner          Profile?  @relation("OwnedSites", fields: [ownerId], references: [id], onDelete: SetNull)
  visibility     String // private | public — NO column default (forces every create to state intent)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  takeoffFlights Flight[]  @relation("TakeoffSite")
  landingFlights Flight[]  @relation("LandingSite")
  homeProfiles   Profile[] @relation("HomeSite")
  zones          Zone[]    @relation("SiteZones")

  // SPRINT-006: an optional custom boundary, replacing the radius circle for
  // this row when present. Null = match by radius exactly as SPRINT-004/005.
  // See lib/sites/boundary.ts for the envelope shape; boundaryColumns() in
  // lib/sites/associate.ts is the sole writer of all five columns together.
  boundary            Json?
  boundaryMinLat      Float?
  boundaryMaxLat      Float?
  boundaryMinLon      Float?
  boundaryMaxLon      Float?
  boundaryUpdatedById String?
  boundaryUpdatedBy   Profile? @relation("BoundaryUpdatedSites", fields: [boundaryUpdatedById], references: [id], onDelete: SetNull)

  // SPRINT-007: community ownership. auditEntries only ever exist for
  // mutations made while this row was PUBLIC (see lib/sites/audit.ts) — a
  // private row's edit history is never recorded, so there is nothing to
  // leak on a later publish. endorsements are a pure display signal.
  auditEntries LocationAuditEntry[] @relation("SiteAuditEntries")
  endorsements SiteEndorsement[]    @relation("SiteEndorsements")

  @@index([lat, lon])
  @@index([ownerId])
  @@index([ownerId, normalizedName])
}

// SPRINT-005: a specific launch/landing spot within a Site (e.g. "North
// Launch" within "Mission Ridge"). A Zone cannot exist without its parent —
// a Site, by contrast, is a fully first-class state with zero zones. Zone
// visibility is INDEPENDENT of its parent's; effective visibility is the
// conjunction (see lib/sites/visibility.ts's canSeeZone) — this is what lets
// a private spot exist under a public site. Sibling-name uniqueness among
// PUBLIC zones is enforced by a raw-SQL partial unique index in the
// migration (Prisma v6 cannot express partial indexes in schema.prisma) —
// deliberately not a plain @@unique, so a private zone can never block or
// leak the existence of a public sibling with the same name.
model Zone {
  id             String   @id @default(cuid())
  siteId         String // REQUIRED — a zone cannot exist alone
  site           Site     @relation("SiteZones", fields: [siteId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String // NFKC + folded, scoped to siblings under one site
  kind           String   @default("unknown") // takeoff | landing | both | unknown
  lat            Float
  lon            Float
  ownerId        String? // null-able for the same SetNull reason as Site.ownerId
  owner          Profile? @relation("OwnedZones", fields: [ownerId], references: [id], onDelete: SetNull)
  visibility     String // private | public — NO column default (forces every create to state intent)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  takeoffFlights Flight[] @relation("TakeoffZone")
  landingFlights Flight[] @relation("LandingZone")

  // SPRINT-006: identical boundary shape to Site — see the comment there.
  boundary            Json?
  boundaryMinLat      Float?
  boundaryMaxLat      Float?
  boundaryMinLon      Float?
  boundaryMaxLon      Float?
  boundaryUpdatedById String?
  boundaryUpdatedBy   Profile? @relation("BoundaryUpdatedZones", fields: [boundaryUpdatedById], references: [id], onDelete: SetNull)

  // SPRINT-007: identical shape to Site — see the comment there.
  auditEntries LocationAuditEntry[] @relation("ZoneAuditEntries")
  endorsements ZoneEndorsement[]    @relation("ZoneEndorsements")

  @@index([lat, lon])
  @@index([siteId])
  @@index([siteId, normalizedName])
  @@index([ownerId])
}

// SPRINT-007: append-only accountability log for public Site/Zone mutations.
// Exactly one of siteId/zoneId is non-null (enforced by a raw-SQL CHECK in
// the migration, num_nonnulls = 1 — Prisma v6 can't express this
// declaratively, same precedent as SPRINT-006's boundary bbox CHECK). Only
// ever written for a mutation made while the row is PUBLIC — see
// lib/sites/audit.ts.
model LocationAuditEntry {
  id        String   @id @default(cuid())
  siteId    String?
  site      Site?    @relation("SiteAuditEntries", fields: [siteId], references: [id], onDelete: Cascade)
  zoneId    String?
  zone      Zone?    @relation("ZoneAuditEntries", fields: [zoneId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     Profile? @relation("LocationAuditEntries", fields: [actorId], references: [id], onDelete: SetNull)
  action    String   // create | published | renamed | boundary_set | boundary_cleared | merge
  detail    Json?    // action-specific display context — never raw geometry, never a private name
  createdAt DateTime @default(now())

  @@index([siteId, createdAt])
  @@index([zoneId, createdAt])
  @@index([actorId])
}

// SPRINT-007: one-per-pilot-per-row endorsement ("upvote"). Self-endorsement
// is allowed — the composite PK is the only thing preventing double-voting.
// No denormalized count column; counts are computed with groupBy, mirroring
// the shipped Kudo pattern (lib/social/kudos.ts).
model SiteEndorsement {
  siteId    String
  site      Site     @relation("SiteEndorsements", fields: [siteId], references: [id], onDelete: Cascade)
  profileId String
  profile   Profile  @relation("SiteEndorsements", fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([siteId, profileId])
  @@index([siteId, createdAt])
}

model ZoneEndorsement {
  zoneId    String
  zone      Zone     @relation("ZoneEndorsements", fields: [zoneId], references: [id], onDelete: Cascade)
  profileId String
  profile   Profile  @relation("ZoneEndorsements", fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([zoneId, profileId])
  @@index([zoneId, createdAt])
}
